{
  "name": "harmony-society-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Harmony Residential Society Management System — Monorepo",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "seed": "npm run seed --prefix backend",
    "seed:backend": "npm run seed --prefix backend",
    "test": "npm test --prefix backend",
    "test:backend": "npm test --prefix backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  }
}
