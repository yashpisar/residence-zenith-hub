# Harmony Society Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:5173,http://localhost:4173

# MongoDB Atlas or Local Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/harmony_society

# JWT Authentication
JWT_ACCESS_SECRET=harmony_jwt_access_secret_key_change_in_production_89412
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=harmony_jwt_refresh_secret_key_change_in_production_56214
JWT_REFRESH_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# Payment Gateway (Optional / Demo fallback enabled by default)
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
